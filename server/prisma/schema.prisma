datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String         @id @default(uuid())
  email        String         @unique
  passwordHash String
  name         String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  journalEntries JournalEntry[]
  habits         Habit[]
  habitLogs      HabitLog[]
  reminders      Reminder[]
  reminderLogs   ReminderLog[]
  settings       UserSettings?
}

model JournalEntry {
  id        String   @id @default(uuid())
  userId    String
  date      String   // "YYYY-MM-DD"
  title     String?
  content   String
  mood      String   @default("😌")
  tags      String   @default("[]") // JSON string of tags array: '["gratitude", "reflection"]'
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

model Habit {
  id                String   @id @default(uuid())
  userId            String
  title             String
  emoji             String   @default("sparkles")
  category          String   @default("Growth")
  targetType        String   @default("boolean") // "boolean" | "count"
  targetCount       Int      @default(1)
  unit              String?
  repeatDays        String   @default("[0,1,2,3,4,5,6]") // JSON string of day numbers: 0=Sun..6=Sat
  isActive          Boolean  @default(true)
  identity          String?  // Atomic Habits: "Lifelong Learner"
  stackTrigger      String?  // Atomic Habits: "After I pour morning coffee ☕"
  stackAfterHabitId String?
  twoMinuteRule     String?  // Atomic Habits: "Read 1 single page"
  isDeleted         Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  habitLogs HabitLog[]

  @@index([userId, category])
}

model HabitLog {
  id                 String   @id @default(uuid())
  userId             String
  habitId            String
  date               String   // "YYYY-MM-DD"
  completed          Boolean  @default(false)
  currentCount       Int      @default(0)
  completedAt        DateTime @default(now())
  isTwoMinuteVersion Boolean  @default(false)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([habitId, date])
  @@index([userId, date])
}

model Reminder {
  id            String   @id @default(uuid())
  userId        String
  label         String
  time          String   // "HH:mm"
  repeatDays    String   @default("[0,1,2,3,4,5,6]") // JSON string of day numbers
  isActive      Boolean  @default(true)
  notifyEnabled Boolean  @default(true)
  isDeleted     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  reminderLogs ReminderLog[]

  @@index([userId])
}

model ReminderLog {
  id          String   @id @default(uuid())
  userId      String
  reminderId  String
  date        String   // "YYYY-MM-DD"
  completed   Boolean  @default(true)
  completedAt DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reminder Reminder @relation(fields: [reminderId], references: [id], onDelete: Cascade)

  @@unique([reminderId, date])
  @@index([userId, date])
}

model UserSettings {
  id                String   @id @default(uuid())
  userId            String   @unique
  displayName       String   @default("Friend")
  theme             String   @default("dark")
  customThemeColors String?  // JSON stringified custom palette
  fontSerif         String   @default("Libre Baskerville")
  fontHand          String   @default("Kalam")
  fontUi            String   @default("DM Sans")
  fontSizeScale     String   @default("normal")
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
