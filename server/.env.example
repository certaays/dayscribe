# Server Port
PORT=5000

# SQLite (Local Dev)
DATABASE_URL="file:./dev.db"

# PostgreSQL (VPS Production)
# DATABASE_URL="postgresql://dayscribe_user:your_strong_password@localhost:5432/dayscribe_db?schema=public"

# Authentication
JWT_SECRET="replace_with_a_long_random_secret_string"
JWT_EXPIRES_IN="30d"

# CORS
CORS_ORIGIN="https://yourdomain.com"
NODE_ENV="production"
